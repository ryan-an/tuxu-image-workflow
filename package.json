{
  "name": "tuxu-image-workflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build && npm run build:server",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "npm run test:build && node scripts/run-tests.mjs",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,css}\" \"shared/**/*.js\" \"server/**/*.{js,ts}\" \"scripts/**/*.mjs\" \"tests/**/*.{js,ts}\" vite.config.js index.html \"tsconfig*.json\" package.json README.md docs/architecture.md tests/README.md compose.yaml",
    "dev:api": "npm run build:server && npm start",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 5173 --strictPort",
    "build:server": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "setup": "node scripts/setup-local.mjs",
    "start": "node scripts/start-local.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.frontend.json",
    "test:production": "npm run test:build && node scripts/run-tests.mjs production",
    "test:build": "tsc -p tsconfig.test.json && node scripts/copy-migrations.mjs build-test",
    "test:unit": "npm run test:build && node scripts/run-tests.mjs unit",
    "test:integration": "npm run test:build && node scripts/run-tests.mjs integration",
    "test:e2e": "npm run test:build && node scripts/run-tests.mjs e2e"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@univerjs/preset-sheets-core": "1.0.4",
    "@univerjs/preset-sheets-drawing": "1.0.4",
    "@univerjs/presets": "1.0.4",
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "jszip": "^3.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
