{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "build-test",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": [
    "server/production/**/*.ts",
    "shared/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.js"
  ],
  "exclude": [
    "tests/legacy",
    "build-test",
    "build-server",
    "dist",
    "node_modules"
  ]
}
