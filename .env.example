# npm run setup fills missing credentials automatically. Never commit .env.
DATABASE_PATH=./data/workspace.sqlite
ASSET_DIRECTORY=./data/assets
APP_PASSWORD=admin
# 64 hexadecimal characters. Preserve this key with backups.
CREDENTIAL_SECRET=
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
# local: analysis 15 / submit 6 / query 8; small: analysis 5 / submit 2 / query 4.
EXECUTION_PROFILE=local
# Optional server-wide caps shared by all workspaces.
PROMPT_CONCURRENCY_LIMIT=
IMAGE_SUBMIT_CONCURRENCY_LIMIT=
IMAGE_QUERY_CONCURRENCY_LIMIT=
# Off by default: HTTP works on local, LAN, Docker and public IP deployments.
REQUIRE_HTTPS=false
# Optional direct HTTPS; npm run setup:https generates a local/IP certificate.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Optional local CA for the Vite development proxy's HTTPS verification.
TLS_CA_FILE=
# Optional HTTPS reverse proxy. Trust only its actual peer IPs/CIDRs.
TRUSTED_PROXIES=
# Optional canonical HTTPS origin, e.g. https://images.example.com
PUBLIC_ORIGIN=
